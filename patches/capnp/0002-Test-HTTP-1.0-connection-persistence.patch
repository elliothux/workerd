+KJ_TEST("HttpHeaders HTTP/1.0 default connection persistence") {
+  HttpHeaderTable::Builder builder;
+  auto table = builder.build();
+  for (auto connection: kj::arr(""_kj, "Connection: Upgrade\r\n"_kj,
+           "Connection: close\r\n"_kj)) {
+    HttpHeaders headers(*table);
+    auto text = kj::str("HTTP/1.0 200 OK\r\nContent-Length: 2\r\n", connection, "\r\n");
