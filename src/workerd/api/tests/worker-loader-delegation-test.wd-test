using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  v8Flags = ["--expose-gc"],
  extensions = [(modules = [
    (name = "workerd-test:public-extension", esModule = "export const label = 'configured';"),
    (name = "cloudflare-internal:workerd-test-helper", internal = true, esModule = "export const label = 'configured';"),
    (name = "cloudflare-internal:workerd-test-wrapped", internal = true, esModule = "import binding from 'cloudflare-internal:wrapped-binding'; import {label} from 'cloudflare-internal:workerd-test-helper'; class Product extends binding.WrappedBinding { #fetcher; constructor(env){super(env.fetcher);this.#fetcher=env.fetcher;} async ping(){return label+':'+await (await this.#fetcher.fetch('http://test/key')).text();} } export default env => new Product(env);"),
  ])],
  services = [
    (name = "factory-peer", worker = (
      modules = [
        (name = "peer", esModule = "export { FactoryPeer } from 'worker';"),
        (name = "worker", esModule = embed "worker-loader-delegation-test.js"),
      ],
      compatibilityFlags = ["nodejs_compat", "experimental", "enable_ctx_exports"],
      bindings = [(name = "factory", workerLoader = (id = "shared-factory", factory = true))],
    )),
    (name = "worker-loader-delegation-test", worker = (
      modules = [(name = "worker", esModule = embed "worker-loader-delegation-test.js")],
      compatibilityFlags = ["nodejs_compat", "experimental", "enable_ctx_exports"],
      durableObjectNamespaces = [
        (className = "InflightActor", uniqueKey = "InflightActor"),
        (className = "Gate", uniqueKey = "Gate"),
      ],
      durableObjectStorage = (inMemory = void),
      bindings = [
        (name = "system", workerLoader = (id = "internal-loader")),
        (name = "factory", workerLoader = (id = "shared-factory", factory = true)),
        (name = "peer", service = (name = "factory-peer", entrypoint = "FactoryPeer")),
        (name = "otherFactory", workerLoader = (factory = true)),
        (name = "capacityFactory", workerLoader = (factory = true)),
      ],
    )),
  ],
);
